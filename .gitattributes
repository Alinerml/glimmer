* text=auto

# 脚本和 CI 配置必须是 LF，否则 Linux / macOS runner 会报 bad interpreter
*.sh text eol=lf
gradlew text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.icns binary
*.jks binary
*.keystore binary
*.ttf binary
*.woff binary
*.woff2 binary
