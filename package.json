{
  "name": "glimmer",
  "private": true,
  "version": "1.0.2",
  "description": "微光 · 把日子，过成星河。一个本地优先的多端微记录应用。",
  "author": "Glimmer",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host",
    "icons": "node scripts/make-icons.mjs",
    "native:assets": "node scripts/make-native-assets.mjs",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder",
    "desktop:dist": "npm run build && electron-builder --win",
    "desktop:dist:mac": "npm run build && electron-builder --mac dmg",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "lz-string": "1.5.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "2.0.0",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "com.glimmer.stars",
    "productName": "微光",
    "artifactName": "Glimmer-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "微光"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.lifestyle",
      "icon": "public/icons/icon-1024.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "public/icons/icon-512.png"
    }
  }
}
